@{
}

@model IEnumerable<Movies>

<table class="table table-striped table-bordered text-center">


    <thead class="thead-dark">
        <tr>

            <th style="width: 15%;">Title</th>
            <th style="width: 10%;">Year</th>
            <th style="width: 15%;">Director</th>
            <th style="width: 12%;">Category</th>
            <th style="width: 8%;">Rating</th>
            <th style="width: 8%;">Edited</th>
            <th style="width: 10%;">Copied to Plex</th>
            <th style="width: 10%;">Lent To</th>
            <th style="width: 12%;">Notes</th>
            <th style="width: 10%;">Actions</th>
        </tr>
        
    </thead>


    <tbody>
        @foreach (var movie in Model)
        {
            <tr>
                <td>@movie.Title</td>
                <td>@movie.Year</td>
                <td>@(movie.Director)</td>
                <td>@(movie.Category?.CategoryName)</td>
                <td>@(movie.Rating)</td>
                <td>@(movie.Edited)</td>
                <td>@(movie.CopiedToPlex)</td>
                <td>@(movie.LentTo)</td>
                <td>@(movie.Notes)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@movie.MovieId" class="btn btn-primary btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@movie.MovieId" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        
        }
        
        </tbody>
</table>