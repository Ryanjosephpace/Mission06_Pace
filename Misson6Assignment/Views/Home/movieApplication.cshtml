@model Movies

<h1>Movie Review Page</h1>

<form method="post" asp-action="@(Model.MovieId == 0 ? "MovieApplication" : "Edit")">


    <input type="hidden" asp-for="MovieId"/>

    <label asp-for="Title">Title:</label>
    <input asp-for="Title" type="text" required />
    <br />


    <label asp-for="Year">Year:</label>
    <input asp-for="Year" type="number" required min="1888"/>
    <br />


    <label asp-for="Director">Director:</label>
    <input asp-for="Director" type="text" required />
    <br />


    <label asp-for="CategoryId">Category:</label>
    <select asp-for="CategoryId" class="form-control w-auto">
        <option value="">Select a Category</option>
        @foreach (var category in ViewBag.Categories)
        {
            <option value="@category.CategoryId">@category.CategoryName</option>
        }
    </select>
    <br />


    <label asp-for="Rating">Rating:</label>
    <select asp-for="Rating" required>
        <option value="G">G</option>
        <option value="PG">PG</option>
        <option value="PG-13">PG-13</option>
        <option value="R">R</option>
        <option value="UR">UR</option>
        <option value="NR">NR</option>
        <option value="TV-G">TV-G</option>
        <option value="TV-PG">TV-PG</option>
        <option value="TV-Y7">TV-Y7</option>
        <option value="TV-14">TV-14</option>
    </select>
    <br />


    <div class="form-group">
        <label>Edited</label><br />

        <input type="radio" asp-for="Edited" value="true" class="form-check-input" required />
        <label class="form-check-label">Yes</label>

        <input type="radio" asp-for="Edited" value="false" class="form-check-input" required />
        <label class="form-check-label">No</label>

        <span asp-validation-for="Edited" class="text-danger"></span>
    </div>


    <div class="form-group">
        <label>Copied to Plex</label><br />

        <input type="radio" asp-for="CopiedToPlex" value="true" class="form-check-input" required />
        <label class="form-check-label">Yes</label>

        <input type="radio" asp-for="CopiedToPlex" value="false" class="form-check-input" required />
        <label class="form-check-label">No</label>

        <span asp-validation-for="CopiedToPlex" class="text-danger"></span>
    </div>




    <label asp-for="LentTo">Lent To:</label>
    <input asp-for="LentTo" type="text" />
    <br />


    <label asp-for="Notes">Notes:</label>
    <input asp-for="Notes" type="text" maxlength="25" />
    <br />
    <button type="submit">Submit</button>
</form>

<script>
    // When the form is submitted, check if 'Edited' is left blank, and set it to null if needed
    document.querySelector("form").onsubmit = function() {
        var editedField = document.querySelector("input[name='Edited']:checked");
        if (!editedField) {
            // If no radio button for 'Edited' is selected, set the value to null
            document.querySelector("input[name='Edited'][value='']").value = null;
        }

        // Check and convert empty values to null for 'LentTo'
        var lentToField = document.querySelector("input[name='LentTo']");
        if (!lentToField.value.trim()) {
            lentToField.value = null; // Set to null if left blank
        }

        // Check and convert empty values to null for 'Notes'
        var notesField = document.querySelector("input[name='Notes']");
        if (!notesField.value.trim()) {
            notesField.value = null; // Set to null if left blank
        }
    };
</script>

